# Copy to .env (git-ignored) and fill in. Real environment variables take precedence.
# texclaim (CLI and `texclaim serve`) reads .env from the current directory and the repo root.

# Required: any LiteLLM model string, e.g. anthropic/claude-sonnet-5-5, openai/gpt-5, ollama/qwen3
# Use "demo" for the offline demo verifier (no key, fake verdicts).
TEXCLAIM_MODEL=

# Provider key for the model above (only the one you use is needed)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Optional: free OpenAlex key (higher limits, full-text downloads)
OPENALEX_API_KEY=
