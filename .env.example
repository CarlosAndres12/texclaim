# texclaim keys and settings. Copy to .env (git-ignored) and fill in only what you use.
# The CLI and `texclaim serve` read .env from the current directory and the repo root.
# Real environment variables always take precedence. Empty lines are ignored.

# ---- Model (required) --------------------------------------------------------------------
# Any LiteLLM model string. Examples:
#   anthropic/claude-sonnet-5-5   anthropic/claude-opus-5-5   anthropic/claude-haiku-5-5
#   openai/gpt-5                  gemini/gemini-2.5-pro       mistral/mistral-large-latest
#   deepseek/deepseek-chat        groq/llama-3.3-70b-versatile openrouter/<vendor>/<model>
#   ollama/qwen3 (local, no key)  demo (offline demo verifier, fake verdicts)
TEXCLAIM_MODEL=

# ---- Provider keys (only the one for your model is needed) -------------------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
# Azure OpenAI (model string: azure/<deployment>)
AZURE_API_KEY=
AZURE_API_BASE=
AZURE_API_VERSION=
# Local Ollama server (default http://localhost:11434)
OLLAMA_API_BASE=

# ---- Sources ------------------------------------------------------------------------------
# Optional free OpenAlex key: higher limits and full-text PDF downloads
OPENALEX_API_KEY=
# Optional Asta / Semantic Scholar API key (Ai2): extra source for open-access PDFs,
# abstracts and full-text snippets when OpenAlex and arXiv have nothing
ASTA_API_KEY=
# Contact email sent to OpenAlex/arXiv as polite-pool identification (optional)
TEXCLAIM_CONTACT_EMAIL=

# ---- Defaults (optional; the web app and CLI flags override these) -----------------------
# Report language: auto | en | es
TEXCLAIM_REPORT_LANGUAGE=
# Claim length: auto | sentence | two | paragraph
TEXCLAIM_CLAIM_SCOPE=
# Maximum LLM spend per run in USD (default 5.00)
TEXCLAIM_MAX_USD=
# Web app address (default 127.0.0.1:8765)
TEXCLAIM_HOST=
TEXCLAIM_PORT=
